{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@scoreboard-fok/server/*": [
        "apps/server/src/*"
      ],
      "@scoreboard-fok/client/*": [
        "apps/client/src/*"
      ],
      "@scoreboard-fok/domain/*": [
        "libs/domain/src/*"
      ],
      "@scoreboard-fok/contracts/*": [
        "libs/contracts/src/*"
      ]
    }
  }
}
