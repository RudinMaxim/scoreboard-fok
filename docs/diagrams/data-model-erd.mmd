erDiagram
    TEAM ||--o{ PLAYER : "current roster"
    TEAM ||--o{ TEAM_MEMBERSHIP : "membership history"
    PLAYER ||--o{ TEAM_MEMBERSHIP : "team periods"

    GAME_DAY ||--o{ MATCH : "groups"
    SCOREBOARD_LAYOUT ||--o{ MATCH : "uses"

    TEAM ||--o{ MATCH : "team A"
    TEAM ||--o{ MATCH : "team B"
    MATCH ||--|| MATCH_STATE : "current snapshot"
    MATCH ||--o{ MATCH_PERIOD_SCORE : "period totals"
    MATCH ||--o{ MATCH_ROSTER : "fixed roster"
    TEAM ||--o{ MATCH_ROSTER : "roster side"
    PLAYER ||--o{ MATCH_ROSTER : "participant"
    MATCH_ROSTER ||--|| MATCH_PLAYER_STAT : "player totals"

    MATCH ||--o{ MATCH_EVENT : "append-only log"
    TEAM ||--o{ MATCH_EVENT : "event team"
    PLAYER ||--o{ MATCH_EVENT : "event player"
    MATCH_ROSTER ||--o{ MATCH_EVENT : "event participant"

    MATCH_EVENT ||--o| SCORE_EVENT : "score details"
    MATCH_EVENT ||--o| FOUL_EVENT : "foul details"
    MATCH_EVENT ||--o| TIMEOUT_EVENT : "timeout details"
    MATCH_EVENT ||--o| CLOCK_EVENT : "clock details"
    MATCH_EVENT ||--o| POSSESSION_EVENT : "possession details"
    MATCH_EVENT ||--o| SCORE_CORRECTION_EVENT : "correction details"

    TEAM {
        uuid id PK
        string name
        string city
        string logo_uri
        datetime created_at
        datetime updated_at
    }

    PLAYER {
        uuid id PK
        uuid current_team_id FK
        string last_name
        string first_name
        string patronymic
        string photo_uri
        int jersey_number
        datetime created_at
        datetime updated_at
    }

    TEAM_MEMBERSHIP {
        uuid id PK
        uuid team_id FK
        uuid player_id FK
        int jersey_number
        date active_from
        date active_to
        datetime created_at
    }

    GAME_DAY {
        uuid id PK
        date game_date
        string venue
        string title
        string status
        datetime created_at
        datetime updated_at
    }

    SCOREBOARD_LAYOUT {
        uuid id PK
        string name
        string layout_preset
        json config
        boolean is_default
        datetime created_at
        datetime updated_at
    }

    MATCH {
        uuid id PK
        uuid game_day_id FK
        uuid team_a_id FK
        uuid team_b_id FK
        uuid scoreboard_layout_id FK
        datetime scheduled_at
        string timezone
        string venue
        int quarter_duration_seconds
        string status
        datetime created_at
        datetime updated_at
    }

    MATCH_ROSTER {
        uuid id PK
        uuid match_id FK
        uuid team_id FK
        uuid player_id FK
        string side
        int jersey_number
        string role
        datetime created_at
    }

    MATCH_STATE {
        uuid match_id PK,FK
        int period_number
        string period_type
        int game_clock_ms
        int shot_clock_ms
        boolean game_clock_running
        boolean shot_clock_running
        int team_a_score
        int team_b_score
        int team_a_fouls_period
        int team_b_fouls_period
        int team_a_timeouts_first_half
        int team_b_timeouts_first_half
        int team_a_timeouts_second_half
        int team_b_timeouts_second_half
        int team_a_timeouts_overtime
        int team_b_timeouts_overtime
        string possession_side
        string display_mode
        datetime saved_at
    }

    MATCH_PERIOD_SCORE {
        uuid id PK
        uuid match_id FK
        uuid team_id FK
        int period_number
        string period_type
        int points
        datetime updated_at
    }

    MATCH_PLAYER_STAT {
        uuid match_roster_id PK,FK
        int points
        int personal_fouls
        boolean fouled_out
        datetime updated_at
    }

    MATCH_EVENT {
        uuid id PK
        uuid match_id FK
        uuid team_id FK
        uuid player_id FK
        uuid match_roster_id FK
        string event_type
        int period_number
        string period_type
        int game_clock_ms
        int shot_clock_ms
        string source
        string operator_role
        string reason
        datetime occurred_at
        datetime created_at
        uuid reverted_event_id FK
    }

    SCORE_EVENT {
        uuid match_event_id PK,FK
        int points_delta
        int team_score_after
        int player_points_after
        string scoring_kind
    }

    FOUL_EVENT {
        uuid match_event_id PK,FK
        int foul_delta
        string foul_type
        int player_fouls_after
        int team_fouls_period_after
        boolean personal_fifth_foul
        boolean team_penalty_after
    }

    TIMEOUT_EVENT {
        uuid match_event_id PK,FK
        string timeout_scope
        int duration_seconds
        int team_timeouts_period_after
        int team_timeouts_half_after
        boolean limit_warning
    }

    CLOCK_EVENT {
        uuid match_event_id PK,FK
        string clock_kind
        string action
        int value_before_ms
        int value_after_ms
        int adjustment_ms
    }

    POSSESSION_EVENT {
        uuid match_event_id PK,FK
        string possession_before
        string possession_after
    }

    SCORE_CORRECTION_EVENT {
        uuid match_event_id PK,FK
        int team_a_score_before
        int team_b_score_before
        int team_a_score_after
        int team_b_score_after
    }
